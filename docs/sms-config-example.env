# 短信服务配置示例
# SMS Service Configuration Example

# 短信服务商选择 (mock, aliyun, tencent)
# SMS Provider (mock, aliyun, tencent)
SMS_PROVIDER=mock

# 阿里云短信配置 (当SMS_PROVIDER=aliyun时需要)
# Aliyun SMS Configuration (required when SMS_PROVIDER=aliyun)
# SMS_APP_ID=your_access_key_id
# SMS_APP_KEY=your_access_key_secret
# SMS_TEMPLATE_ID=your_template_id
# SMS_SIGN_NAME=your_sign_name

# 腾讯云短信配置 (当SMS_PROVIDER=tencent时需要)
# Tencent SMS Configuration (required when SMS_PROVIDER=tencent)
# SMS_APP_ID=your_app_id
# SMS_APP_KEY=your_app_key
# SMS_TEMPLATE_ID=your_template_id
# SMS_SIGN_NAME=your_sign_name

# Mock模式说明:
# 在开发环境中，使用mock模式不需要真实的短信服务
# 验证码会在后端日志中输出，便于调试
# Mock Mode Note:
# In development environment, mock mode doesn't require real SMS service
# Verification codes will be output in backend logs for debugging